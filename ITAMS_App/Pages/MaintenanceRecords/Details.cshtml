@page
@model ITAMS_App.Pages.MaintenanceRecords.DetailsModel
@{
    ViewData["Title"] = "Maintenance Record Details";
}

<h1>Maintenance Record Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Asset</dt>
        <dd class="col-sm-10">@Model.MaintenanceRecord?.Asset?.AssetType?.Type_Name</dd>

        <dt class="col-sm-2">Issue</dt>
        <dd class="col-sm-10">@Model.MaintenanceRecord?.Issue_Description</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.MaintenanceRecord?.Maintenance_Date.ToShortDateString()</dd>

        <dt class="col-sm-2">Technician</dt>
        <dd class="col-sm-10">@Model.MaintenanceRecord?.Technician_Name</dd>
    </dl>
</div>

<!-- Navigation buttons -->
<a asp-page="./Edit" asp-route-id="@Model.MaintenanceRecord?.Record_Id">Edit</a> |
<a asp-page="./Index">Back to List</a>
