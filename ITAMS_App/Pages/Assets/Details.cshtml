@page
@model ITAMS_App.Pages.Assets.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<h1>Asset Details</h1>

@if (Model.Asset == null)
{
    <div class="alert alert-danger">Asset not found.</div>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Asset Type</dt>
        <dd class="col-sm-10">
            @Model.Asset.AssetType?.Type_Name ?? "Unknown Type"
        </dd>

        <dt class="col-sm-2">Serial Number</dt>
        <dd class="col-sm-10">@Model.Asset.Serial_Number</dd>

        <dt class="col-sm-2">Purchase Date</dt>
        <dd class="col-sm-10">@Model.Asset.Purchase_Date.ToShortDateString()</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Asset.Status</dd>
    </dl>
    
    <a asp-page="./Edit" asp-route-id="@Model.Asset.Asset_Id">Edit</a>
    <a asp-page="./Index">Back to List</a>
}
