@page
@model ITAMS_App.Pages.Assets.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Asset</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Asset.AssetType.Type_Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Asset.AssetType.Type_Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Asset.Serial_Number)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Asset.Serial_Number)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Asset.Purchase_Date)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Asset.Purchase_Date)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Asset.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Asset.Status)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Asset.Asset_Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>

<!-- Error Modal -->
<div class="modal fade" id="deleteErrorModal" tabindex="-1" aria-labelledby="errorLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="errorLabel">Cannot Delete Asset</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        🐱 This asset is currently assigned to an employee and cannot be deleted.
        
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Okay</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        window.onload = function () {
            var hasError = '@TempData["DeleteError"]' !== '';
            if (hasError) {
                var deleteModal = new bootstrap.Modal(document.getElementById('deleteErrorModal'));
                deleteModal.show();
            }
        };
    </script>
}
