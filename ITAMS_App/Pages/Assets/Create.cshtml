@page
@model ITAMS_App.Pages.Assets.CreateModel

@{
    ViewData["Title"] = "Create Asset";
}

<h1>Create Asset</h1>

<h4>Asset</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            
            <div class="form-group">
                <label asp-for="Asset.AssetType_Id" class="control-label"></label>
                <select asp-for="Asset.AssetType_Id" class="form-control" asp-items="Model.AssetTypeOptions">
                        <option value="">--Select Type--</option>
                </select>
                <span asp-validation-for="Asset.AssetType_Id" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="Asset.Serial_Number" class="control-label"></label>
                <input asp-for="Asset.Serial_Number" class="form-control" />
                <span asp-validation-for="Asset.Serial_Number" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Asset.Purchase_Date" class="control-label"></label>
                <input asp-for="Asset.Purchase_Date" class="form-control" type="date" />
                <span asp-validation-for="Asset.Purchase_Date" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Asset.Status" class="control-label"></label>
                <select asp-for="Asset.Status" class="form-control" asp-items="Model.StatusOptions">
                    <option value="">--Select Status--</option>
                </select>
                <span asp-validation-for="Asset.Status" class="text-danger"></span>
            </div>


            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<!--error message-->
@if (TempData["DuplicateSerialError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
        @TempData["DuplicateSerialError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
