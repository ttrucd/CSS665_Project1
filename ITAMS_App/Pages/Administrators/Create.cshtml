@page
@model ITAMS_App.Pages_Administrators.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>Administrator</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Administrator.Name" class="control-label"></label>
                <input asp-for="Administrator.Name" class="form-control" />
                <span asp-validation-for="Administrator.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Administrator.Email" class="control-label"></label>
                <input asp-for="Administrator.Email" class="form-control" />
                <span asp-validation-for="Administrator.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Administrator.Department" class="control-label"></label>
                <input asp-for="Administrator.Department" class="form-control" />
                <span asp-validation-for="Administrator.Department" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Administrator.Permission" class="control-label"></label>
                <select asp-for="Administrator.Permission" class="form-control" asp-items="Model.PermissionOptions"></select>
                <span asp-validation-for="Administrator.Permission" class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

