@page
@model ITAMS_App.Pages_Administrators.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Administrators</h1>

<p>
    <a a asp-page="/Administrators/Create" class="btn btn-primary mb-3">Create</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Administrator[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Administrator[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Administrator[0].Department)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Administrator[0].Permission)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Administrator) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Department)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Permission)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Admin_Id" class="btn btn-sm btn-warning">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Admin_Id" class="btn btn-sm btn-info">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Admin_Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
