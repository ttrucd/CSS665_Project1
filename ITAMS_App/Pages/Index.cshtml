@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<h2>IT Asset Management System</h2>

<div class="row mt-5">
    <div class="d-flex flex-wrap justify-content-center mt-5 gap-4">
    <div class="pastel-card text-center p-4" style="width: 250px;">
        <h5> Assets</h5>
        <p>Track laptops, desktops, and more.</p>
        <a class="btn btn-primary" asp-page="/Assets/Index">View Assets</a>
    </div>

    <div class="pastel-card text-center p-4" style="width: 250px;">
        <h5> Maintenance</h5>
        <p>Manage maintenance records for IT equipment.</p>
        <a class="btn btn-primary" asp-page="/MaintenanceRecords/Index">View Records</a>
    </div>

    <div class="pastel-card text-center p-4" style="width: 250px;">
        <h5>Licenses</h5>
        <p>Monitor software licenses and expiration dates.</p>
        <a class="btn btn-primary" asp-page="/SoftwareLicenses/Index">View Licenses</a>
    </div>

    <div class="pastel-card text-center p-4" style="width: 250px;">
        <h5>Admins</h5>
        <p>Oversee administrator roles and permissions.</p>
        <a class="btn btn-primary" asp-page="/Administrators/Index">Manage Admins</a>
    </div>

    <div class="pastel-card text-center p-4" style="width: 250px;">
        <h5>Employees</h5>
        <p>Oversee Employees and their roles.</p>
        <a class="btn btn-primary" asp-page="/Employees/Index">View Employees</a>
    </div>
</div>