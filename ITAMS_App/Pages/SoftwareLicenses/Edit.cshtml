@page
@model ITAMS_App.Pages_SoftwareLicenses.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>SoftwareLicense</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SoftwareLicense.License_Id" />
            <div class="form-group">
                
                <label asp-for="SoftwareLicense.Software_Name" class="control-label"></label>
                <input asp-for="SoftwareLicense.Software_Name" class="form-control" />
                <span asp-validation-for="SoftwareLicense.Software_Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="SoftwareLicense.License_Key" class="control-label"></label>
                <input asp-for="SoftwareLicense.License_Key" class="form-control" />
                <span asp-validation-for="SoftwareLicense.License_Key" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="SoftwareLicense.Expiration_Date" class="control-label"></label>
                <input asp-for="SoftwareLicense.Expiration_Date" class="form-control" />
                <span asp-validation-for="SoftwareLicense.Expiration_Date" class="text-danger"></span>
            </div>
        
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

